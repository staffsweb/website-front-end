{% set slabBg = slabBg ? 'slab--bg-' ~ slabBg : 'slab--bg-slate' %}
{% set bgImgURL = bgImg is not empty ?: ('/images/masthead' ~ random(5) ~ '.jpg') %}

<div class="masthead  masthead--subject">
  <div class="wrap">
    <div class="masthead__course-info">
      <div class="masthead__course-options">
        <h1 class="margin-top-3xl  margin-bottom-sm">Studying Law</h1>
        <p class="font-lg">at University of Staffordshire</p>

        <ul class="list--inline">
          <li>
            {% include '@button' with {
              text: 'Browse courses',
              classes: ['button--burgundy']
            } %}
          </li>
          <li>
            {% include '@button' with {
              text: 'Order a prospectus',
              classes: ['button--digital-blue']
            } %}
          </li>
        </ul>

        <div class="masthead__body">
          <h2 class="h5">UK Top 3 for student satisfaction with Law</h2>
          <p>Guardian University Guide 2027</p>

          <h2 class="h5">UK Top 10 for student feedback with Law</h2>
          <p>Guardian University Guide 2027</p>

          <h2 class="h5">UK Top 5 for Teaching Quality with Law</h2>
          <p>Sunday Times University Guide 2027</p>
        </div>
      </div>

      <div class="masthead__course-hero">
        {% if bgImg %}
          {{ bgImg }}
        {% else %}
          <img src="{{ bgImgURL | path }}"/>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<div class="wrap">
  <p class="intro  margin-top-2xl">Subject page body copy</p>
</div>