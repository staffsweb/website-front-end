<h2><a id="sticky-waypoint"></a>Show the CTA when reaching here</h2>

<article class="sticky-open-day-cta">
    <div class="wrap">
        <div class="sticky-open-day-cta__content">
            <div>
                <span>Next Open Day </span>
                <strong class="sticky-open-day-cta__date">17 October</strong>
            </div>
            <div>
                <a class="button  button--neon  button--xs" href="#">Book now</a>
            </div>
        </div>
    </div>
</article>
<script>
    (function () {
        function initStickyOpenDayCta() {
            if (typeof window.jQuery !== 'function' || !window.Waypoint) {
                return false;
            }

            var $ = window.jQuery;
            var $nav = $('#sticky-waypoint');
            var $cta = $('.sticky-open-day-cta');

            if (!$nav.length || !$cta.length) {
                return false;
            }

            $nav.waypoint(function (direction) {
                if (direction === 'down') {
                    $cta.stop(true, true).slideDown(200);
                } else {
                    $cta.stop(true, true).slideUp(200);
                }
            }, {
                offset: 0
            });

            return true;
        }

        if (window.jQuery && window.Waypoint) {
            initStickyOpenDayCta();
            return;
        }

        var retries = 0;
        var timer = window.setInterval(function () {
            if (window.jQuery && window.Waypoint) {
                if (initStickyOpenDayCta()) {
                    window.clearInterval(timer);
                }
            }

            retries += 1;
            if (retries >= 100) {
                window.clearInterval(timer);
            }
        }, 50);
    })();
</script>

